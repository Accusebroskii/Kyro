{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "lib/db/src",
    "outDir": "lib/db/dist",
    "types": ["node"]
  },
  "include": ["lib/db/src/**/*.ts"]
}
